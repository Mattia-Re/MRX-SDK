<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>true</IsPackable>
        <Version>1.0.0-rc2</Version>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>Core ASP.NET Core building blocks for the MRX SDK: model binding configuration, ProblemDetails extensions, and object model validation extensions. Requires the ASP.NET Core shared framework (server-side only).</Description>
        <PackageTags>mrx;aspnetcore;model-binding;validation</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\MRX.Core.Common\src\MRX.Core.Common.csproj" />
        <ProjectReference Include="..\..\MRX.Json\src\MRX.Json\MRX.Json.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MRX.Core.Tests"/>
    </ItemGroup>

</Project>
