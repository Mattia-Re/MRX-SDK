<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>true</IsPackable>
        <Version>1.0.0-rc1</Version>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>Shared ASP.NET Core primitives used across the MRX SDK, including ProblemDetails extension helpers and endpoint feature descriptors.</Description>
        <PackageTags>mrx;aspnetcore;problemdetails</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

</Project>
