<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>true</IsPackable>
        <Version>1.0.0-rc3</Version>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>Automatically wires ASP.NET Core ProblemDetails validation errors from HTTP responses into UI form/model state, for use in Blazor and similar client applications.</Description>
        <PackageTags>mrx;blazor;blazor-wasm;problemdetails;validation</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.12"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.Forms" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\MRX.Core.Common\src\MRX.Core.Common.csproj"/>
        <ProjectReference Include="..\..\MRX.Json.Reflection\MRX.Json.Reflection.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2"/>
        <InternalsVisibleTo Include="MRX.UI.ErrorsAutoWiring.Tests"/>
        <InternalsVisibleTo Include="MRX.UI.ErrorsAutoWiring.Blazor.Tests"/>
    </ItemGroup>

</Project>
