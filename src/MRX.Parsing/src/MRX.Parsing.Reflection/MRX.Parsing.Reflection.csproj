<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>true</IsPackable>
        <Version>1.0.0-rc1</Version>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>Reflection-based runtime generic parser and numeric parsing helpers, built on top of MRX.Parsing.</Description>
        <PackageTags>mrx;parsing;reflection</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\MRX.Parsing\MRX.Parsing.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MRX.Parsing.Reflection.Tests"/>

        <InternalsVisibleTo Include="MRX.Json.Reflection"/>
        <InternalsVisibleTo Include="MRX.Json.Reflection.Tests"/>
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2"/>
    </ItemGroup>

</Project>
